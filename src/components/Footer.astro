---
const { nom, t } = Astro.props
---
<div class="text-slate-600 dark:text-slate-400 text-xs border-t border-slate-100 dark:border-slate-800 pt-4">
  <div class="flex flex-col gap-1 items-center lg:items-start">
    <p class="italic text-slate-600 dark:text-slate-400">{t['footer.design']}</p>
    <p class="font-semibold text-slate-600 dark:text-slate-400">
      &copy; {new Date().getFullYear()}
      <span class="text-indigo-600 dark:text-indigo-400">{nom}</span>
    </p>
  </div>
</div>
