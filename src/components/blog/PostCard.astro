---
import { localizedUrl } from '../../i18n/utils.ts';

const { lang, slug, title, excerpt, publishedAt, categories = [], tags = [] } = Astro.props
---

<article
  transition:name={`post-${slug}`}
  class="group relative rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 shadow-sm hover:shadow-md hover:border-indigo-300 dark:hover:border-indigo-500 transition-all duration-300"
>
  <!-- Títol amb "stretched link" accessible -->
  <h2 transition:name={`title-${slug}`} class="text-2xl font-semibold text-indigo-700 dark:text-indigo-300 group-hover:underline">
    <a
      href={localizedUrl(lang, `/blog/${slug}`)}
      class="after:absolute after:inset-0 focus:outline-none focus-visible:after:ring-2 focus-visible:after:ring-indigo-500 focus-visible:after:rounded-xl"
    >
      {title}
    </a>
  </h2>

  <!-- Data -->
  <p class="text-xs text-slate-500 mt-1">
    <time datetime={publishedAt}>{new Date(publishedAt).toLocaleDateString(lang)}</time>
  </p>

  <!-- Excerpt -->
  {excerpt && (
    <p class="mt-3 text-slate-700 dark:text-slate-300 leading-relaxed line-clamp-3">
      {excerpt}
    </p>
  )}

  <!-- Categories i Tags — z-10 per quedar sobre el stretched link -->
  <div class="relative z-10 mt-4 flex flex-wrap gap-2 text-xs">
    {categories.map(c => (
      <a href={localizedUrl(lang, `/blog?category=${c.slug}`)}
        class="inline-block px-2 py-1 rounded-full bg-indigo-100 dark:bg-indigo-800 text-indigo-700 dark:text-indigo-200 hover:bg-indigo-200 dark:hover:bg-indigo-700 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500">
        {c.title}
      </a>
    ))}
    {tags.map(t => (
      <a href={localizedUrl(lang, `/blog?tag=${t.slug}`)}
        class="inline-block px-2 py-1 rounded bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-300 dark:hover:bg-slate-600 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500">
        #{t.title}
      </a>
    ))}
  </div>
</article>