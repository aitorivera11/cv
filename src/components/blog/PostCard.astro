---
import { localizedUrl } from '../../i18n/utils.ts';

const { lang, slug, title, excerpt, publishedAt, categories = [], tags = [] } = Astro.props
---

<article
  transition:name={`post-${slug}`}
  class="group relative rounded-2xl border border-slate-200 dark:border-slate-800
    bg-white dark:bg-slate-900/60
    p-6 shadow-sm
    hover:shadow-lg hover:border-indigo-300/60 dark:hover:border-indigo-500/40
    hover:-translate-y-0.5
    transition-all duration-200 ease-out"
>
  <!-- Category badges -->
  {categories.length > 0 && (
    <div class="relative z-10 mb-3 flex flex-wrap gap-1.5">
      {categories.map(c => (
        <a
          href={localizedUrl(lang, `/blog?category=${c.slug}`)}
          class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold
            bg-indigo-50 dark:bg-indigo-900/40
            text-indigo-600 dark:text-indigo-400
            border border-indigo-200/60 dark:border-indigo-700/40
            hover:bg-indigo-100 dark:hover:bg-indigo-900/70
            transition-colors duration-150
            focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500"
        >
          {c.title}
        </a>
      ))}
    </div>
  )}

  <!-- Title with stretched link -->
  <h2
    transition:name={`title-${slug}`}
    class="text-xl font-bold text-slate-900 dark:text-white
      group-hover:text-indigo-600 dark:group-hover:text-indigo-400
      transition-colors duration-200 leading-snug"
  >
    <a
      href={localizedUrl(lang, `/blog/${slug}`)}
      class="after:absolute after:inset-0 focus:outline-none focus-visible:after:ring-2
        focus-visible:after:ring-indigo-500 focus-visible:after:rounded-2xl"
    >
      {title}
    </a>
  </h2>

  <!-- Date -->
  <p class="mt-1.5 text-xs font-medium text-slate-400 dark:text-slate-500">
    <time datetime={publishedAt}>
      {new Date(publishedAt).toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' })}
    </time>
  </p>

  <!-- Excerpt -->
  {excerpt && (
    <p class="mt-3 text-sm text-slate-600 dark:text-slate-300 leading-relaxed line-clamp-3">
      {excerpt}
    </p>
  )}

  <!-- Tags -->
  {tags.length > 0 && (
    <div class="relative z-10 mt-4 flex flex-wrap gap-1.5">
      {tags.map(tag => (
        <a
          href={localizedUrl(lang, `/blog?tag=${tag.slug}`)}
          class="inline-block px-2 py-0.5 rounded text-xs font-medium
            bg-slate-100 dark:bg-slate-800
            text-slate-500 dark:text-slate-400
            hover:bg-slate-200 dark:hover:bg-slate-700
            transition-colors duration-150
            focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500"
        >
          #{tag.title}
        </a>
      ))}
    </div>
  )}
</article>
