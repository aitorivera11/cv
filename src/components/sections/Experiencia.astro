---
import AnimateOnScroll from '../AnimateOnScroll.jsx';
import { getLangFromUrl, useTranslations } from '../../i18n/utils.ts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { experiencies } = Astro.props;
---

<AnimateOnScroll client:visible triggerOnce={false}>
  <section id="experiencia" class="mb-24 scroll-mt-24">
    <h2 class="section-heading">
      {t['nav.experience']}
    </h2>

    <ul class="space-y-3">
      {experiencies?.map((feina) => (
        <li class="experience-card group">
          <div class="grid sm:grid-cols-8 gap-4 sm:gap-6">
            <!-- Date badge -->
            <div class="sm:col-span-2 flex sm:flex-col sm:items-start items-center gap-2">
              <span class="text-xs font-semibold uppercase tracking-widest text-slate-400 dark:text-slate-500 leading-relaxed">
                {feina.dates}
              </span>
            </div>

            <!-- Content -->
            <div class="sm:col-span-6 space-y-2">
              <h3 class="text-lg font-bold text-slate-900 dark:text-white
                group-hover:text-indigo-600 dark:group-hover:text-indigo-400
                transition-colors duration-200 leading-snug">
                {feina.titol}
              </h3>
              <p class="text-sm font-medium text-slate-500 dark:text-slate-400">
                {feina.empresa}
              </p>
              <div class="prose prose-sm prose-slate dark:prose-invert max-w-none
                prose-p:text-slate-600 dark:prose-p:text-slate-300
                prose-p:leading-relaxed prose-p:my-0">
                <p>{feina.descripcio}</p>
              </div>
              {feina.tecnologies?.length > 0 && (
                <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Tecnologies">
                  {feina.tecnologies.map(tag => (
                    <li class="tag-pill">{tag}</li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>
</AnimateOnScroll>
