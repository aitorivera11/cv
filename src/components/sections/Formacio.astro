---
import AnimateOnScroll from '../AnimateOnScroll.jsx';
import { getLangFromUrl, useTranslations } from '../../i18n/utils.ts';
import { AcademicCapIcon } from '@heroicons/react/24/solid';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { formacions } = Astro.props;
---

<AnimateOnScroll client:visible triggerOnce={false}>
  <section id="formacio" class="mb-24 scroll-mt-24">
    <h2 class="section-heading">
      {t['nav.education']}
    </h2>
    <ul class="space-y-3">
      {formacions?.map((estudi) => (
        <li class="education-card group">
          <div class="flex items-start gap-4">
            <div class="mt-0.5 flex-shrink-0 w-9 h-9 rounded-xl flex items-center justify-center
              bg-indigo-50 dark:bg-indigo-900/30
              text-indigo-500 dark:text-indigo-400
              group-hover:bg-indigo-100 dark:group-hover:bg-indigo-900/50
              transition-colors duration-200">
              <AcademicCapIcon className="w-5 h-5" aria-hidden="true" />
            </div>
            <div>
              <h3 class="text-base font-bold text-slate-900 dark:text-white
                group-hover:text-indigo-600 dark:group-hover:text-indigo-400
                transition-colors duration-200 leading-snug">
                {estudi.titulacio}
              </h3>
              <p class="mt-0.5 text-sm text-slate-500 dark:text-slate-400">
                {estudi.centre}
                <span aria-hidden="true" class="mx-1.5 text-slate-300 dark:text-slate-600">·</span>
                <span class="sr-only">, </span>
                <time>{estudi.dates}</time>
              </p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>
</AnimateOnScroll>
