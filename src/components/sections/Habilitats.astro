---
import HabilitatsAnimated from '../HabilitatsAnimated.jsx';
import { getLangFromUrl, useTranslations } from '../../i18n/utils.ts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { tecniques, clau } = Astro.props;
---

<HabilitatsAnimated
  client:visible
  tecniques={tecniques}
  clau={clau}
  t={t}
/>
