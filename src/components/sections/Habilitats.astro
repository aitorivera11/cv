---
import AnimateOnScroll from '../AnimateOnScroll.jsx';
import { getLangFromUrl, useTranslations } from '../../i18n/utils.ts';
import { PuzzlePieceIcon, CommandLineIcon } from '@heroicons/react/24/solid';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { tecniques, clau } = Astro.props;
---

<AnimateOnScroll client:visible triggerOnce={false}>
  <section id="habilitats" class="mb-24 scroll-mt-24">
    <h2 class="section-heading">
      {t['nav.skills']}
    </h2>
    <div class="space-y-10">
      <div>
        <h3 class="flex items-center gap-2 text-sm font-bold text-slate-700 dark:text-slate-300 mb-4 uppercase tracking-wide">
          <CommandLineIcon className="w-4 h-4 text-indigo-500 dark:text-indigo-400" aria-hidden="true" />
          {t['skills.technical']}
        </h3>
        <ul class="flex flex-wrap gap-2" aria-label={t['skills.technical']}>
          {tecniques?.map((hab) => (
            <li class="skill-pill-tech">{hab.nom}</li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="flex items-center gap-2 text-sm font-bold text-slate-700 dark:text-slate-300 mb-4 uppercase tracking-wide">
          <PuzzlePieceIcon className="w-4 h-4 text-violet-500 dark:text-violet-400" aria-hidden="true" />
          {t['skills.soft']}
        </h3>
        <ul class="flex flex-wrap gap-2" aria-label={t['skills.soft']}>
          {clau?.map((hab) => (
            <li class="skill-pill-soft">{hab.nom}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</AnimateOnScroll>
