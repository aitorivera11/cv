---
import AnimateOnScroll from '../AnimateOnScroll.jsx';
import { ui } from '../../i18n/ui.ts';
import { GlobeAltIcon } from '@heroicons/react/24/solid';
import BarraIdiomes from '../BarraIdiomes.jsx';

const getLangFromUrl = (url: URL) => url.pathname.split('/')[1] || 'ca';
const lang = getLangFromUrl(Astro.url) as keyof typeof ui;
const t = ui[lang];

const idiomes = [
  { nom: t['languages.catalan'], nivell: t['languages.native'], percent: 100 },
  { nom: t['languages.spanish'], nivell: t['languages.native'], percent: 100 },
  { nom: t['languages.english'], nivell: t['languages.basic'], percent: 30 },
];
---

<AnimateOnScroll client:visible triggerOnce={false}>
  <section id="idiomes" class="mb-24 scroll-mt-24">
    <h2 class="section-heading">
      {t['nav.languages']}
    </h2>

    <ul class="space-y-5">
      {idiomes.map((idioma) => (
        <li class="flex items-center gap-3">
          <span class="flex items-center gap-2 w-28 shrink-0 text-sm font-semibold text-slate-700 dark:text-slate-200">
            <GlobeAltIcon
              className="w-4 h-4 text-indigo-400 dark:text-indigo-500 shrink-0"
              aria-hidden="true"
            />
            {idioma.nom}
          </span>

          <div
            class="flex-1 bg-slate-200 dark:bg-slate-800 rounded-full h-1.5"
            role="progressbar"
            aria-valuenow={idioma.percent}
            aria-valuemin={0}
            aria-valuemax={100}
            aria-label={`${idioma.nom}: ${idioma.nivell} (${idioma.percent}%)`}
          >
            <BarraIdiomes client:visible percent={idioma.percent} />
          </div>

          <span
            class="w-16 shrink-0 text-xs font-medium text-slate-500 dark:text-slate-400 text-right"
            aria-hidden="true"
          >
            {idioma.nivell}
          </span>
        </li>
      ))}
    </ul>
  </section>
</AnimateOnScroll>
