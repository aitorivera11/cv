---
import AnimateOnScroll from '../AnimateOnScroll.jsx';
import { getLangFromUrl, useTranslations } from '../../i18n/utils.ts';
import { BriefcaseIcon, CodeBracketIcon, MapPinIcon } from '@heroicons/react/24/solid';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { sobremi } = Astro.props;

const facts = [
  { Icon: BriefcaseIcon, text: t['facts.profile'] },
  { Icon: MapPinIcon, text: t['facts.where'] },
  { Icon: CodeBracketIcon, text: t['facts.stack'] },
];
---

<AnimateOnScroll client:visible triggerOnce={false}>
  <section id="sobre-mi" class="mb-24 scroll-mt-24">
    <h2 class="section-heading">
      {t['nav.about']}
    </h2>
    <ul class="mb-8 flex flex-wrap gap-2" aria-label={t['nav.about']}>
      {facts.map(({ Icon, text }) => (
        <li class="inline-flex items-center gap-2 rounded-full border border-slate-200 dark:border-slate-700 bg-white/70 dark:bg-slate-900/60 px-3.5 py-1.5 text-sm font-medium text-slate-700 dark:text-slate-200">
          <Icon className="w-4 h-4 text-indigo-500 dark:text-indigo-400" aria-hidden="true" />
          {text}
        </li>
      ))}
    </ul>
    <div class="prose prose-slate dark:prose-invert max-w-none
      prose-p:text-slate-600 dark:prose-p:text-slate-300
      prose-p:leading-relaxed prose-p:text-base
      prose-strong:text-indigo-600 dark:prose-strong:text-indigo-400
      prose-a:text-indigo-600 dark:prose-a:text-indigo-400
      prose-a:no-underline hover:prose-a:underline">
      <div set:html={sobremi}></div>
    </div>
  </section>
</AnimateOnScroll>
