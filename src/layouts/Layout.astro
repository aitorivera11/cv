---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import themeScript from '../scripts/theme.js?raw';
import { SEO } from 'astro-seo';
import BackToTop from '../components/BackToTop.jsx';
import Analytics from '../components/Analytics.astro';

interface HreflangUrl {
  lang: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  lang?: string;
  canonical?: string;
  image?: string;
  jsonLd?: object[];
  hreflangUrls?: HreflangUrl[];
}

const {
  title = 'Aitor Rivera Garcia',
  description = 'Desenvolupador web i gestor de projectes. Portafoli personal.',
  lang = 'ca',
  canonical = `https://aitorivera.com/`,
  image = 'https://aitorivera.com/og-image.jpg',
  jsonLd = [],
  hreflangUrls = [],
} = Astro.props;

const hreflangLinks = [
  ...hreflangUrls.map(({ lang: l, url }) => ({ rel: 'alternate', hreflang: l, href: url })),
  ...(hreflangUrls.length > 0
    ? [{ rel: 'alternate', hreflang: 'x-default', href: hreflangUrls.find(u => u.lang.startsWith('ca'))?.url || canonical }]
    : []),
];
---
<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Font preload to eliminate render-blocking font flash -->
    <link
      rel="preload"
      href="/fonts/SpaceGrotesk-VariableFont_wght.ttf"
      as="font"
      type="font/truetype"
      crossorigin="anonymous"
    />

    <!-- Inline theme script first to prevent FOUT -->
    <script is:inline set:html={themeScript}></script>

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      openGraph={{
        basic: {
          title: title,
          type: 'website',
          image: image,
          url: canonical,
        },
        image: {
          url: image,
          width: 1200,
          height: 630,
          alt: title,
        },
        optional: {
          locale: lang === 'ca' ? 'ca_ES' : lang === 'es' ? 'es_ES' : 'en_US',
          siteName: 'Aitor Rivera Garcia',
        },
      }}
      twitter={{
        card: 'summary_large_image',
        site: '@aitorivera',
        creator: '@aitorivera',
        title: title,
        description: description,
        image: image,
      }}
      extend={{
        meta: [
          { name: 'robots', content: 'index, follow, max-snippet:-1, max-image-preview:large' },
          { name: 'author', content: 'Aitor Rivera Garcia' },
          { name: 'theme-color', content: '#6366f1', media: '(prefers-color-scheme: light)' },
          { name: 'theme-color', content: '#0f172a', media: '(prefers-color-scheme: dark)' },
          { name: 'color-scheme', content: 'light dark' },
        ],
        link: [
          { rel: 'icon', type: 'image/svg+xml', href: '/favicon.svg' },
          { rel: 'sitemap', href: '/sitemap-index.xml' },
          ...hreflangLinks,
        ],
      }}
    />

    {jsonLd.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <ClientRouter />
    <Analytics />
  </head>
  <body class="font-sans bg-slate-100 dark:bg-slate-900 text-slate-800 dark:text-slate-300 antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100]
             focus:px-4 focus:py-2 focus:rounded-lg focus:bg-indigo-600 focus:text-white
             focus:font-semibold focus:shadow-lg focus:outline-none"
    >
      {lang === 'ca' ? 'Salta al contingut' : lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}
    </a>
    <slot />
    <BackToTop client:idle />
  </body>
</html>
