---
import Layout from '../../../layouts/Layout.astro'
import BlogSidebar from '../../../components/blog/BlogSidebar.astro'
import RelatedPosts from '../../../components/blog/RelatedPosts.astro'
import { normalizeLocale, useTranslations } from '../../../i18n/utils'
import CopyLinkButton from '../../../components/CopyLinkButton.astro';
import { 
  SocialShare, 
  TwitterShareButton, 
  LinkedInShareButton, 
  WhatsAppShareButton, 
  EmailShareButton,
  BlueskyShareButton
} from "astro-social-share";
import {
  getBlogSettings,
  getCategories,
  getPostBySlug,
  getPosts,
  getSiteSettings,
  getTags,
} from '../../../lib/directus-content';

const SHARE_BUTTONS = [
  LinkedInShareButton,
  TwitterShareButton,
  WhatsAppShareButton,
  EmailShareButton,
  BlueskyShareButton
];

export async function getStaticPaths() {
  const posts = await getPosts('ca')
  const locales = ['en', 'es']

  const paths = []
  for (const locale of locales) {
    for (const post of posts) {
      paths.push({ params: { locale, slug: post.slug } })
    }
  }

  return paths
}

const lang = normalizeLocale(Astro.params.locale)
const t = useTranslations(lang)
const slug = Astro.params.slug || ''

const [post, sidebarSettings, settings, categories, tags, recentPosts] = await Promise.all([
  getPostBySlug(slug, lang),
  getSiteSettings(lang),
  getBlogSettings(lang),
  getCategories(lang),
  getTags(lang),
  getPosts(lang),
])

const siteUrl = 'https://aitorivera.com'
const shareUrl = `${siteUrl}/${lang}/blog/${slug}`

function estimateReadTime(html: string): number {
  const text = html.replace(/<[^>]+>/g, ' ')
  const wordCount = text.trim().split(/\s+/).filter(Boolean).length
  return Math.max(1, Math.ceil(wordCount / 200))
}
const readTime = post?.content ? estimateReadTime(post.content) : null
const seoImage = post?.coverImageUrl || settings?.defaultCoverUrl || `${siteUrl}/og-image.jpg`
const canonicalUrl = `${siteUrl}/${lang === 'ca' ? '' : `${lang}/`}blog/${slug}`

const hreflangUrls = [
  { lang: 'ca-ES', url: `${siteUrl}/blog/${slug}` },
  { lang: 'es-ES', url: `${siteUrl}/es/blog/${slug}` },
  { lang: 'en-US', url: `${siteUrl}/en/blog/${slug}` },
]

const articleSchema = post ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  image: seoImage,
  url: canonicalUrl,
  datePublished: post.publishedAt,
  author: {
    '@type': 'Person',
    name: sidebarSettings?.nom || 'Aitor Rivera Garcia',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Person',
    name: sidebarSettings?.nom || 'Aitor Rivera Garcia',
    url: siteUrl,
  },
  inLanguage: lang === 'ca' ? 'ca-ES' : lang === 'es' ? 'es-ES' : 'en-US',
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
} : null
---

<Layout
  title={`${post?.title || 'Article'} | ${sidebarSettings?.nom || 'Aitor Rivera'}`}
  description={post?.excerpt || ''}
  lang={lang}
  canonical={canonicalUrl}
  image={seoImage}
  ogType="article"
  hreflangUrls={hreflangUrls}
  jsonLd={articleSchema ? [articleSchema] : []}
>
  <div class="max-w-screen-xl mx-auto lg:flex">
    <BlogSidebar
      lang={lang}
      settings={sidebarSettings}
      blogTitle={settings?.title || 'Blog d'Aitor Rivera'}
      blogDescription={settings?.description || 'Articles sobre desenvolupament, gestió i experiències personals.'}
      categories={categories}
      tags={tags}
      recentPosts={recentPosts.slice(0, 5)}
      t={t}
    />

    <main id="main-content" class="w-full lg:w-3/5 p-6 lg:p-16 lg:py-24 pt-16">
      {post ? (
        <article transition:name={`post-${slug}`}>
          {post.coverImageUrl && (
            <div class="mb-8 -mx-6 lg:-mx-16 rounded-2xl overflow-hidden">
              <img
                src={post.coverImageUrl}
                alt={post.title}
                class="w-full h-48 sm:h-64 md:h-80 object-cover"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          )}
          <header class="mb-10 pb-6 border-b border-slate-200 dark:border-slate-700">
            <h1 transition:name={`title-${slug}`} class="text-4xl font-extrabold text-slate-900 dark:text-white leading-tight tracking-tight mb-4">
              {post.title}
            </h1>

            <div class="flex flex-wrap gap-4 items-center text-sm mb-4">
              <time class="inline-flex items-center gap-1 text-slate-500 dark:text-slate-400" dateTime={post.publishedAt}>
                <svg class="w-4 h-4 text-indigo-400 dark:text-indigo-300" fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 7V3M16 7V3M3 11h18M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                {new Date(post.publishedAt).toLocaleDateString(lang)}
              </time>
              {readTime && (
                <span class="inline-flex items-center gap-1 text-slate-500 dark:text-slate-400">
                  <svg class="w-4 h-4 text-indigo-400 dark:text-indigo-300" fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  {readTime} {t['blog.readTime']}
                </span>
              )}

              {post.categories?.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {post.categories.map(cat => (
                    <a href={`/${lang === 'ca' ? '' : `${lang}/`}blog?category=${cat.slug}`} 
                       class="inline-block px-2 py-1 rounded-full bg-indigo-100 dark:bg-indigo-800 text-indigo-700 dark:text-indigo-200 text-xs font-semibold hover:bg-indigo-200 dark:hover:bg-indigo-700 transition">
                      {cat.title}
                    </a>
                  ))}
                </div>
              )}

              {post.tags?.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {post.tags.map(tag => (
                    <a href={`/${lang === 'ca' ? '' : `${lang}/`}blog?tag=${tag.slug}`} 
                       class="inline-block px-2 py-1 rounded bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs">
                      #{tag.title}
                    </a>
                  ))}
                </div>
              )}
            </div>

            {post.excerpt && (
              <p class="mt-4 text-lg text-slate-700 dark:text-slate-300">{post.excerpt}</p>
            )}

            <div class="mt-3 flex items-center gap-4">
              <span class="font-semibold text-slate-700 dark:text-slate-300">{t['blog.share'] || 'Comparteix:'}</span>
              <div class="flex items-center gap-4">
                <SocialShare
                  url={shareUrl}
                  title={post.title}
                  description={post.excerpt}
                  buttons={SHARE_BUTTONS}
                  via="aitorivera"
                />
                <slot name="astro-social-share-css" slot="astro-social-share-css">
                  <style is:global>
                    .astro-social-share {
                      display: flex;
                      gap: 0.5rem;
                      align-items: center;
                    }
                  </style>
                </slot>

                <div class="h-6 w-px bg-slate-200 dark:bg-slate-700"></div> 
                <CopyLinkButton url={shareUrl} t={t} />
              </div>
            </div>
          </header>

          <div class="prose prose-slate dark:prose-invert max-w-none
            prose-headings:font-bold prose-headings:tracking-tight
            prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
            prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
            prose-p:leading-relaxed prose-p:text-slate-700 dark:prose-p:text-slate-300
            prose-a:text-indigo-600 dark:prose-a:text-indigo-400 prose-a:no-underline hover:prose-a:underline
            prose-strong:text-slate-900 dark:prose-strong:text-white
            prose-code:text-indigo-600 dark:prose-code:text-indigo-400 prose-code:bg-slate-100 dark:prose-code:bg-slate-800 prose-code:rounded prose-code:px-1
            prose-pre:bg-slate-900 dark:prose-pre:bg-slate-950 prose-pre:rounded-xl
            prose-blockquote:border-indigo-500 prose-blockquote:text-slate-600 dark:prose-blockquote:text-slate-400
            prose-img:rounded-xl prose-img:shadow-md" set:html={post.content}></div>

          {post.relatedPosts?.length > 0 && (
            <RelatedPosts lang={lang} posts={post.relatedPosts} />
          )}
        </article>
      ) : (
        <div class="bg-slate-100 dark:bg-slate-800 p-6 rounded-lg text-center">
          <p>{t['blog.notFound'] || 'No s'ha trobat aquest article.'}</p>
        </div>
      )}
    </main>
  </div>
</Layout>
